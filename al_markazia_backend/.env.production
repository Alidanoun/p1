# ═════════════════════════════════════════════════════════════════════════════
# 🔒 AL-MARKAZIA ENTERPRISE PRODUCTION ENVIRONMENT TEMPLATE
# ⚠️ WARNING: DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO VERSION CONTROL.
# This file provides production-ready configuration defaults and schema definitions.
# Suitable for automated injection via HashiCorp Vault, AWS Secrets Manager, or Doppler.
# ═════════════════════════════════════════════════════════════════════════════

# ─── 🏢 Core Environment Settings ─────────────────────────────────────────────
NODE_ENV=production
PORT=5000
TIMEZONE=Asia/Amman
ADMIN_PANEL_URL=https://admin.almarkazia.com
CLIENT_APP_URL=https://app.almarkazia.com

# ─── 🗄️ Database (PostgreSQL) ────────────────────────────────────────────────
# Production connection URI template. Must map directly to private database topology.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace_with_secure_db_password_min_32_chars
POSTGRES_DB=al_markazia_prod_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public&pool_timeout=30

# ─── ⚡ Memory & Messaging Cache (Redis) ──────────────────────────────────────
# Distributed state engine backing Pub/Sub messaging, Rate Limiting, and Session Contexts.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password_min_32_chars
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ─── 🔐 Cryptographic Secrets & JWT Engine ────────────────────────────────────
# MANDATORY: Every cryptographic secret MUST exceed 32 randomized high-entropy bytes.
# If these fields contain placeholders or weak payloads, the application bootstrap logic halts immediately.
JWT_SECRET=replace_with_high_entropy_jwt_access_secret_key_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_high_entropy_jwt_refresh_secret_key_min_32_chars
ENCRYPTION_KEY=replace_with_high_entropy_field_encryption_key_min_32_chars

# Asymmetric KeyPairs for Zero-Trust Micro-Auth Validation
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Session Expiry Policies (Mirrors production secrets.js source of truth)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=12

# ─── 🛡️ Advanced Security & Rate Limiting Configurations ──────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000        # 15 Minutes
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=60000        # 1 Minute
CORS_ALLOWED_ORIGINS=https://admin.almarkazia.com,https://app.almarkazia.com

# ─── 📧 Notification & SMTP Service ───────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_production_smtp_gateway_api_secret_key
EMAIL_FROM_ADDRESS=noreply@almarkazia.com
EMAIL_FROM_NAME="Al-Markazia Systems"

# ─── 🔔 Cloud Messaging Push Channels (Firebase Admin SDK) ────────────────────
FIREBASE_PROJECT_ID=al-markazia-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@al-markazia-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── 👁️ Sentry Observability & Telemetry ──────────────────────────────────────
SENTRY_DSN=https://replace_with_actual_project_id@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production

# ─── 📁 File Persistence & Upload Controls ────────────────────────────────────
UPLOAD_STORAGE_PROVIDER=local            # Options: local | s3
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ─── 🚩 Feature Flags & Operational Overrides ─────────────────────────────────
ENABLE_REALTIME_METRICS_BROADCAST=true
ENABLE_PESSIMISTIC_FINANCIAL_LOCKING=true
ENABLE_STRICT_DEVICE_FINGERPRINT_BINDING=true
SKIP_SECRETS_VALIDATION=false
