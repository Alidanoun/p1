{
  "name": "al_markazia_backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "npx @dotenvx/dotenvx run -- node src/server.js",
    "dev": "npx @dotenvx/dotenvx run -- node ../scripts/sync-ip.js && npx @dotenvx/dotenvx run -- nodemon src/server.js",
    "seed": "npx @dotenvx/dotenvx run -- node prisma/seed.js",
    "maintenance:repair-admin": "npx @dotenvx/dotenvx run -- node scripts/maintenance/repair_admin.js",
    "maintenance:seed-branches": "npx @dotenvx/dotenvx run -- node scripts/maintenance/seed_branches.js",
    "maintenance:check-db": "npx @dotenvx/dotenvx run -- node scripts/utils/check_db_state.js",
    "maintenance:check-status": "npx @dotenvx/dotenvx run -- node scripts/utils/check_restaurant_status.js",
    "cleanup": "npx @dotenvx/dotenvx run -- node scripts/cleanup_test_data.js",
    "test": "npx @dotenvx/dotenvx run -- jest --runInBand --detectOpenHandles",
    "test:watch": "npx @dotenvx/dotenvx run -- jest --watch --runInBand",
    "test:coverage": "npx @dotenvx/dotenvx run -- jest --coverage --runInBand",
    "test:financial-lock": "npx @dotenvx/dotenvx run -- jest tests/financial-lock.test.js --runInBand",
    "lint": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "build": "echo 'No build step for CommonJS' && exit 0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transformIgnorePatterns": [],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/prisma/generated/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/tests/mocks/uuid.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.67.0",
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.52.0",
    "@sentry/profiling-node": "^10.52.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.74.1",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",

    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "file-type": "^16.5.4",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.6",
    "luxon": "^3.7.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "opossum": "^9.0.0",
    "prisma": "^6.19.2",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "autocannon": "^8.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
