# ── Core ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────
# Local development example:
DATABASE_URL="postgresql://admin:password123@localhost:5432/al_markazia_db?schema=public&connection_limit=20"

# ── Authentication & Security ───────────────────────────
# IMPORTANT: Use strong, unique secrets for each.
# Generate via: openssl rand -base64 48
JWT_SECRET=                # Required: Random string
REFRESH_TOKEN_SECRET=      # Required: Random string (must be unique)

# 🔐 PII Encryption (AES-256-CBC)
ENCRYPTION_KEY=            # Required: 64-char hex string or long random string

# 🛡️ Seed Credentials (Use ONLY for initial setup)
ADMIN_DEFAULT_PASSWORD=    # Recommended: Set a strong password for scripts/seedAdmin.js

# Token Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Redis (BullMQ + Cache) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=debug

# ── Firebase (FCM) ───────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=  # Single-line JSON content

# ── External Services ────────────────────────────────
SENTRY_DSN=               # Optional: For error monitoring
EMAIL_USER=               # Required for SMTP
EMAIL_PASS=               # Required for SMTP (App Password)
EMAIL_FROM_NAME=Al Markazia

# ── Automated Off-site Database Backups ──────────────
BACKUP_S3_BUCKET=         # Target Cloud Bucket (e.g. al-markazia-db-backups)
AWS_ACCESS_KEY_ID=        # Remote Storage Access Key
AWS_SECRET_ACCESS_KEY=    # Remote Storage Secret Key
AWS_DEFAULT_REGION=       # Cloud Region (e.g. me-central-1 or us-east-1)
BACKUP_RETENTION_DAYS=7   # Local threshold before cleanup (Cloud relies on Lifecycle Rules)