# ── Core ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────
# Local development example:
POSTGRES_PASSWORD=         # Required: Strong password (min 32 chars)
DATABASE_URL="postgresql://admin:${POSTGRES_PASSWORD}@localhost:5432/al_markazia_db?schema=public&connection_limit=20"

# ── Authentication & Security ───────────────────────────
# IMPORTANT: Use strong, unique secrets for each.
# Generate JWT secrets via: node -e "console.log(require('crypto').randomBytes(36).toString('base64').replace(/[+/=]/g,''))"
JWT_SECRET=                # Required: 48-char random string
REFRESH_TOKEN_SECRET=      # Required: 48-char random string (must be different from JWT_SECRET)

# 🔐 PII Encryption (AES-256)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=            # Required: 64-char hex string

# 🧂 Encryption Key Derivation Salt
# Generate via: node -e "console.log(require('crypto').randomBytes(24).toString('base64').replace(/[+/=]/g,''))"
ENCRYPTION_SALT=           # Required: Unique salt for scrypt KDF (min 16 chars)

# 🔐 RSA Key Pair for JWT (2048-bit minimum)
# Generate via: node -e "const c=require('crypto');const{privateKey,publicKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{format:'pem',type:'spki'},privateKeyEncoding:{format:'pem',type:'pkcs8'}});console.log('JWT_PRIVATE_KEY='+privateKey.replace(/\\n/g,'\\\\n'));console.log('JWT_PUBLIC_KEY='+publicKey.replace(/\\n/g,'\\\\n'));"
JWT_PRIVATE_KEY=           # Required: PEM-encoded RSA private key (single line with \n)
JWT_PUBLIC_KEY=            # Required: PEM-encoded RSA public key (single line with \n)

# 🛡️ Admin Seeding (Use ONLY for initial setup)
# Password is NOT stored in .env — it is generated or provided via CLI:
#   node scripts/seedAdmin.js --password=YourStrongPassword
#   npx prisma db seed -- --password=YourStrongPassword

# Token Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Redis (BullMQ + Cache) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=app_main
REDIS_PASSWORD=                    # Required: Strong password (min 32 chars)
REDIS_WORKER_USERNAME=app_worker
REDIS_WORKER_PASSWORD=             # Required: Strong password (min 32 chars)

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=debug

# ── Firebase (FCM) ───────────────────────────────────
# Extract from your Firebase service account JSON:
# 1. project_id → FIREBASE_PROJECT_ID
# 2. client_email → FIREBASE_CLIENT_EMAIL
# 3. private_key → FIREBASE_PRIVATE_KEY (keep quotes and \n for newlines)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── External Services ────────────────────────────────
SENTRY_DSN=               # Optional: For error monitoring
EMAIL_USER=               # Required for SMTP
EMAIL_PASS=               # Required for SMTP (App Password)
EMAIL_FROM_NAME=Al Markazia

# ── Automated Off-site Database Backups ──────────────
BACKUP_S3_BUCKET=         # Target Cloud Bucket (e.g. al-markazia-db-backups)
AWS_ACCESS_KEY_ID=        # Remote Storage Access Key
AWS_SECRET_ACCESS_KEY=    # Remote Storage Secret Key
AWS_DEFAULT_REGION=       # Cloud Region (e.g. me-central-1 or us-east-1)
BACKUP_RETENTION_DAYS=7   # Local threshold before cleanup (Cloud relies on Lifecycle Rules)