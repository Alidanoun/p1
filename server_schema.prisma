generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum UserRole {
  ADMIN
  BRANCH_MANAGER
  MANAGER
  STAFF
  CUSTOMER
}

/// 🛡️ [ARCHITECTURAL-DECISION]: User uses an Int autoincrement primary key for high-performance internal joins,
/// but exposes a globally unique `uuid` string for secure external API reference, token signatures,
/// and polymorphic relations (e.g. RefreshTokens, SystemAuditLogs).
model User {
  id           Int      @id @default(autoincrement())
  email        String
  emailHash    String?  @unique
  phone        String?  @unique
  phoneHash    String?  @unique
  name         String?
  /// @validate { minLength: 8, pattern: "Complexity Required: 1 Upper, 1 Lower, 1 Number, 1 Special" }
  password     String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  fcmToken     String?
  uuid         String   @unique @default(uuid())
  tokenVersion Int      @default(1)
  authVersion  Int      @default(1)
  permissionVersion Int @default(1)
  sessionEpoch      Int @default(1)
  failedAttempts Int     @default(0)
  lockUntil      DateTime?

  // Branch Integration
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  managedBranches UserBranch[]
  notificationPreferences UserNotificationPreference[]
  
  timezone        String   @default("UTC")
  quietHoursStart Int      @default(23)
  quietHoursEnd   Int      @default(7)
  pinHash         String?

  @@index([branchId])
}

model UserNotificationPreference {
  id        Int      @id @default(autoincrement())
  userId    Int
  category  String   // operational, financial, marketing, system
  isEnabled Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    Int
  branchId  String
  user      User     @relation(fields: [userId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
}

/// 🛡️ [ARCHITECTURAL-DECISION]: Branch uses a String (UUID) primary key to prevent ID enumeration attacks,
/// ensure secure multi-tenancy isolation, and support future distributed or offline branch synchronization.
model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  country   String?  @default("JO")
  timezone  String?  @default("Africa/Cairo")
  isEmergencyClosed Boolean   @default(false)
  closureReason     String?
  reopenAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visibleInApp      Boolean   @default(true)
  appDisplayOrder   Int       @default(0)

  users     User[]
  managedUsers UserBranch[]
  orders    Order[]
  branchItems BranchItem[]
  financialLedger FinancialLedger[]
  happyHours HappyHour[]
  snapshots      DailyFinancialSnapshot[] @relation("BranchSnapshots")
  reviews        Review[]
  metrics        BranchMetric?
  auditLogs      SystemAuditLog[]
  financialApprovals FinancialApproval[]
  branchVariants BranchVariant[]
  businessPolicies BusinessPolicy[]
  permissions   BranchPermissions?
  dailyReports  DailyReport[]
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT_PIN
  EDIT_PIN_READ
  FULL
}

model BranchPermissions {
  id                  String          @id @default(uuid())
  branchId            String          @unique
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  liveOrders          PermissionLevel @default(FULL)
  manageOrders        PermissionLevel @default(FULL)
  menu                PermissionLevel @default(FULL)
  notifications       PermissionLevel @default(FULL)
  reviews             PermissionLevel @default(VIEW)
  loyalty             PermissionLevel @default(VIEW)
  rewardsStore        PermissionLevel @default(NONE)
  advancedAnalytics   PermissionLevel @default(VIEW)
  financials          PermissionLevel @default(VIEW)
  deliveryZones       PermissionLevel @default(EDIT_PIN)
  auditLog            PermissionLevel @default(VIEW)
  settings            PermissionLevel @default(EDIT_PIN)

  canToggleLiveMode   Boolean         @default(false)
  canModifyWorkHours  PermissionLevel @default(EDIT_PIN)

  updatedAt           DateTime        @updatedAt
  updatedBy           String          // UUID of admin
}

model BranchItem {
  id          String   @id @default(uuid())
  branchId    String
  itemId      Int
  isAvailable Boolean  @default(true)
  stockCount  Int      @default(-1)

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, itemId])
  @@index([branchId])
}

model BranchVariant {
  id            Int      @id @default(autoincrement())
  branchId      String
  variantId     Int
  isAvailable   Boolean  @default(true)
  version       Int      @default(1)
  
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant       ItemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([branchId, variantId])
  @@index([branchId])
}

model Category {
  id            Int     @id @default(autoincrement())
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  image         String?
  isActive      Boolean @default(true)
  isDeleted     Boolean @default(false)
  deletedAt     DateTime?
  sortOrder     Int     @default(0)
  items         Item[]
}

model Item {
  id                Int               @id @default(autoincrement())
  title             String
  titleEn           String?
  description       String?
  descriptionEn     String?
  basePrice         Decimal           @db.Decimal(10, 2)
  image             String?
  categoryId        Int
  isAvailable       Boolean           @default(true)
  isFeatured        Boolean           @default(false)
  preparationTime   Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  version           Int               @default(1)
  cachedAvgRating   Float?            @default(0)
  cachedReviewCount Int?              @default(0)
  excludeFromStats  Boolean           @default(false)
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  isGlobal          Boolean           @default(true) // ðŸ§¬ [PHASE 3] If true, appears in all branches. If false, only assigned.
  availabilitySchedule Json?     // {"mon": ["08:00","14:00"], ...}
  
  category          Category          @relation(fields: [categoryId], references: [id])
  variants          ItemVariant[]
  modifierGroups    ModifierGroup[]
  orderItems        OrderItem[]
  reviews           Review[]
  branchItems       BranchItem[]

  @@index([categoryId, isAvailable])
  @@index([isAvailable, createdAt])
}

model ItemVariant {
  id          Int      @id @default(autoincrement())
  itemId      Int
  name        String   // "Small", "Large"
  nameEn      String?
  priceDiff   Decimal  @db.Decimal(10, 2) // +2.00, -1.00
  isDefault   Boolean  @default(false)
  isAvailable Boolean  @default(true)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branchVariants BranchVariant[]
}

model ModifierGroup {
  id          Int            @id @default(autoincrement())
  itemId      Int
  groupName   String
  groupNameEn String?
  type        String         @default("SINGLE") // SINGLE, MULTI
  isRequired  Boolean        @default(false)
  isActive    Boolean        @default(true)
  minSelection Int           @default(0)
  maxSelection Int           @default(1)
  sortOrder   Int            @default(0)
  modifiers   ItemModifier[]
  item        Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model ItemModifier {
  id          Int           @id @default(autoincrement())
  groupId     Int
  name        String
  nameEn      String?
  price       Decimal       @default(0) @db.Decimal(10, 2)
  isDefault   Boolean       @default(false)
  isAvailable Boolean       @default(true)
  sortOrder   Int           @default(0)
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Order {
  id               Int                @id @default(autoincrement())
  orderNumber      String             @unique
  customerName     String
  customerPhone    String
  customerPhoneHash String?
  customerNameHash  String?
  customerId       Int?

  // Branch Integration
  branchId         String
  branch           Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderType        String
  status           String             @default("pending")
  paymentStatus    String             @default("unpaid")
  paymentMethod    String             @default("cash")
  subtotal         Decimal            @default(0) @db.Decimal(10, 2)
  deliveryFee      Decimal            @default(0) @db.Decimal(10, 2)
  discount         Decimal            @default(0) @db.Decimal(10, 2)
  tax              Decimal            @default(0) @db.Decimal(10, 2)
  total            Decimal            @default(0) @db.Decimal(10, 2)
  modificationStatus String           @default("NONE") // NONE, PENDING_CUSTOMER, MODIFIED
  cancellationFee    Decimal          @default(0) @db.Decimal(10, 2)
  address                String?
  notes                  String?
  estimatedReadyAt       DateTime?
  estimatedArrivalAt     DateTime?
  preparationTimeMinutes Int?               @default(20)
  deliveryTimeMinutes    Int?               @default(15)
  rating                 Int?
  ratingComment          String?
  isRatingApproved       Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  version          Int                @default(1)
  eventSequence    Int                @default(1) // ðŸ›¡ï¸ Monotonic scoped sequence for this specific aggregate
  previousVersion  Int                @default(0) // ðŸ”— Link to previous state for causal tracking
  causedByEventId  String?                        // ðŸ•µï¸ Traceback to the event that triggered this state
  snapshotEpoch    Int                @default(1) // ðŸ›ï¸ Resync boundary for major resets
  isDeleted        Boolean            @default(false)
  isArchived       Boolean            @default(false)
  pointsAwarded    Boolean            @default(false)
  deletedAt        DateTime?
  deliveryMinOrder Decimal?           @db.Decimal(10, 2)
  deliveryZoneId   String?
  deliveryZoneName String?
  tenantId         String?            @default("default-restaurant")
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source           String             @default("app") // app, manual
  auditLogs        OrderAuditLog[]
  cancellation     OrderCancellation?
  orderItems       OrderItem[]
  payment          Payment?
  reviews          Review[]
  awardedPoints    AwardedLoyaltyPoints?
  happyHourId      String?
  happyHourDiscount Decimal?          @default(0) @db.Decimal(10, 2)
  happyHourMultiplier Decimal?        @default(1.0) @db.Decimal(3, 2)
  couponRequests   CouponRequest[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt, status])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, status])
  @@index([branchId, isDeleted, status])
}

model Event {
  id            String   @id @default(uuid())
  type          String
  aggregateId   Int
  aggregateType String   @default("order")
  payload       Json
  metadata      Json?
  version       Int
  tenantId      String?  @default("default-restaurant")
  createdAt     DateTime @default(now())

  @@index([aggregateId])
  @@index([type])
  @@index([tenantId])
  @@index([createdAt])
}

model OrderItem {
  id                Int             @id @default(autoincrement())
  orderId           Int
  itemId            Int?
  itemName          String
  itemNameEn        String?
  quantity          Int             @default(1)
  unitPrice         Decimal         @db.Decimal(10, 2)
  selectedOptions   String?
  selectedOptionsEn String?
  lineTotal         Decimal         @db.Decimal(10, 2)
  notes             String?
  status            OrderItemStatus @default(normal)
  rejectionReason   String?
  item              Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  order             Order           @relation(fields: [orderId], references: [id])
  
  // Replacement Logic
  replacedFromId    Int?
  replacedFrom      OrderItem?      @relation("ItemReplacement", fields: [replacedFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacements      OrderItem[]     @relation("ItemReplacement")
  originalPriceAtOrder Decimal?     @db.Decimal(10, 2)

  // New fields for Partial Cancellation & Replacements
  suggestedReplacementItemId Int?
  resolutionPreference       String?    // DEDUCT_FROM_BILL, COUPON_REQUEST
  replacementStatus          String?    // PENDING, ACCEPTED, REJECTED

  @@index([orderId])
  @@index([itemId])
}

/// 🛡️ [ARCHITECTURAL-DECISION]: Customer uses an Int autoincrement primary key for legacy join performance,
/// but exposes a globally unique `uuid` string for public API endpoints and polymorphic authentication.
model Customer {
  id                  Int                @id @default(autoincrement())
  name                String
  phone               String?            @unique
  phoneHash           String?            @unique
  nameHash            String?
  email               String?
  emailHash           String?            @unique
  /// @validate { minLength: 8, pattern: "Complexity Required: 1 Upper, 1 Lower, 1 Number, 1 Special" }
  password            String?
  address             String?
  fcmToken            String?
  points              Int                @default(0)
  walletBalance       Decimal            @default(0) @db.Decimal(10, 2)
  totalOrders         Int                @default(0)
  tier                String             @default("SILVER") // SILVER, GOLD, PLATINUM
  cancellationCount   Int                @default(0)
  isBlacklisted       Boolean            @default(false)
  isDeleted           Boolean            @default(false)
  deletedAt           DateTime?
  blacklistedAt       DateTime?
  blacklistExpiresAt  DateTime?
  blacklistReason     String?
  blacklistReasonCode String?
  blacklistSource     String?
  blacklistedBy       String?
  blacklistSeverity   String             @default("LOW")
  riskScore           Float              @default(0)
  riskScoreUpdatedAt  DateTime?
  authVersion         Int                @default(1)
  permissionVersion   Int                @default(1)
  sessionEpoch        Int                @default(1)
  createdAt           DateTime           @default(now())
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  username            String?            @unique
  uuid                String             @unique @default(uuid())
  tokenVersion        Int                @default(1)
  failedAttempts      Int                @default(0)
  lockUntil           DateTime?
  auditLogs           CustomerAuditLog[]
  orders              Order[]
  reviews             Review[]
  customerRewards     CustomerReward[]
  timezone            String?            @default("Africa/Cairo")
  quietHoursStart     Int                @default(23)
  quietHoursEnd       Int                @default(7)
  notificationPreferences CustomerNotificationPreference[]
  loyaltyLedgers      LoyaltyLedger[]
  notifications       Notification[] @relation("NotificationCustomer")
  couponRequests      CouponRequest[]

  @@index([isBlacklisted])
}

model CustomerNotificationPreference {
  id        Int      @id @default(autoincrement())
  customerId Int
  category  String   // operational, financial, marketing, system
  isEnabled Boolean  @default(true)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category])
}

model Payment {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique
  method         String
  amount         Decimal   @db.Decimal(10, 2)
  status         String
  transactionRef String?
  paidAt         DateTime?
  order          Order     @relation(fields: [orderId], references: [id])
}

model Notification {
  id            Int      @id @default(autoincrement())
  customerId    Int?
  customer      Customer? @relation("NotificationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerPhone String?  // @deprecated — kept for backward compatibility during migration
  title         String
  titleEn       String?
  message       String
  messageEn     String?
  type          String
  isRead        Boolean  @default(false)
  orderId       Int?
  targetRoute   String?
  createdAt     DateTime @default(now())
  fcmSent       Boolean  @default(false)
  lastError     String?
  metadata      Json?
  retryCount    Int      @default(0)
  socketSent    Boolean  @default(false)
  status        String   @default("PENDING")
  severity      String   @default("INFO") // INFO, WARN, CRITICAL
  alertType     String?  // FINANCIAL_HIGH_RISK, TRANSACTION_FAILURE, SECURITY_BREACH
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([customerId])
  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id                 Int              @id @default(autoincrement())
  itemId             Int
  rating             Int
  comment            String?          @db.VarChar(500)
  status             ModerationStatus @default(PENDING)
  fingerprint        String?          @db.VarChar(64) // SHA-256 of IP+DeviceID+UA
  rejectedReason     String?
  images             String[]         @default([])
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  customerId         Int
  orderId            Int?
  branchId           String?
  driverId           Int?
  
  ipAddress          String?
  userAgent          String?
  isFlagged          Boolean          @default(false)
  isVerifiedPurchase Boolean          @default(false)

  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  item               Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order              Order?           @relation(fields: [orderId], references: [id])
  branch             Branch?          @relation(fields: [branchId], references: [id])
  replies            Reply[]

  @@unique([customerId, orderId, itemId]) // One review per item per order
  @@index([itemId, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt])
  @@index([branchId, status])
  @@index([fingerprint])
}

model Reply {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  authorId  String   // User or Customer UUID
  authorRole String  // ADMIN, DRIVER
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model OrderCancellation {
  id              Int      @id @default(autoincrement())
  orderId         Int      @unique
  reason          String
  cancelledBy     String
  previousStatus  String
  status          String   @default("pending")
  rejectionReason String?
  adminName       String?
  refundedAmount  Decimal? @default(0) @db.Decimal(10, 2)
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id])
}

model OrderAuditLog {
  id              Int      @id @default(autoincrement())
  orderId         Int
  eventType       String
  eventAction     String
  changedBy       String
  changedByRole   String
  previousData    String?
  newData         String?
  changedFields   String?
  rejectionReason String?
  integrityHash   String?
  previousHash    String?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@index([eventType])
}

model OrderAuditLogArchive {
  id              Int      @id @default(autoincrement())
  orderId         Int
  eventType       String
  eventAction     String
  changedBy       String
  changedByRole   String
  previousData    String?
  newData         String?
  changedFields   String?
  rejectionReason String?
  integrityHash   String?
  createdAt       DateTime @default(now())
}

model IdempotencyRecord {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  status       String   @default("processing")
  responseCode Int?
  responseBody String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

model NotificationLog {
  id          Int                @id @default(autoincrement())
  userId      String?            // Supports generic string User/Customer UUID
  customerId  Int?
  orderId     Int?
  type        String
  title       String?
  body        String?
  messageId   String?
  status      NotificationStatus @default(PENDING)
  error       String?
  retries     Int                @default(0)
  maxRetries  Int                @default(3)
  nextRetryAt DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId, status])
  @@index([createdAt(sort: Desc)])
}

model CustomerAuditLog {
  id               Int      @id @default(autoincrement())
  customerId       Int
  eventType        String
  eventAction      String
  changedBy       String
  changedByRole    String
  reason           String?
  previousData     String?
  newData          String?
  diff             String?
  severitySnapshot String?
  requestId        String?
  actionCategory   String   @default("CUSTOMER_MODERATION")
  userAgent        String?
  deviceId         String?
  requestSource    String?
  ip               String?
  createdAt        DateTime @default(now())
  customer         Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

model DeliveryZone {
  id        String   @id @default(uuid())
  nameAr    String   @unique
  nameEn    String?
  fee       Decimal  @db.Decimal(10, 2)
  minOrder  Decimal? @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 🛡️ [ARCHITECTURAL-DECISION]: RefreshToken uses a String UUID primary key. 
/// The `userId` field is a String because it functions as a polymorphic identifier storing the unique `uuid`
/// of either a User (staff/admin) or a Customer. This enables a unified session table without resorting to
/// multiple distinct token tables or complex, hard-to-maintain polymorphic relational structures in Prisma.
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  jti       String?  @unique
  userId    String
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isRevoked Boolean  @default(false)
  isUsed    Boolean  @default(false)
  tokenFamily String?
  fingerprint String?

  @@index([userId])
  @@index([token])
  @@index([jti])
  @@index([tokenFamily])
}

model HealthMetric {
  id        Int      @id @default(autoincrement())
  score     Int
  status    String
  services  Json
  latencies Json
  errorRate Float?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String?
  phoneHash String?
  email     String?
  emailHash String?
  codeHash  String
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  purpose   String   @default("login")
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  metadata  Json?

  @@index([phone, purpose, used])
  @@index([email, purpose, used])
  @@index([expiresAt])
}

model SystemAuditLog {
  id           String   @id @default(uuid())
  userId       String?  // Can be User uuid or Customer uuid
  userEmail    String?
  userRole     String?
  action       String   // LOGIN_SUCCESS, PRICE_UPDATE, etc.
  entityType   String?  // Order, Item, Setting, etc.
  entityId     String?  // ID or UUID of the entity
  status       String   @default("SUCCESS") // SUCCESS, FAIL
  severity     String   @default("INFO")    // INFO, WARN, CRITICAL
  ip           String?
  userAgent    String?
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  metadata     Json?    // Stores diffs: { before: {}, after: {} }
  createdAt    DateTime @default(now())
  isDeleted    Boolean  @default(false)

  @@index([userId])
  @@index([action])
  @@index([branchId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([isDeleted])
}

model RestaurantSettings {
  id                          Int       @id @default(1)
  timezone                    String    @default("Asia/Amman")
  isEmergencyClosed           Boolean   @default(false)
  closureReason               String?
  reopenAt                    DateTime?
  lastOrderMinutesBeforeClose Int       @default(15) // Grace Period
  updatedAt                   DateTime  @updatedAt
}

model WorkingHour {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      // 0 (Sunday) to 6 (Saturday)
  openTime  String   // "HH:mm" e.g., "09:00"
  closeTime String   // "HH:mm" e.g., "23:00"
  isClosed  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}

enum OrderItemStatus {
  normal
  pending_partial_cancel
  cancelled
  rejected
  pending_customer_resolution
  pending_replacement_approval
}

model LoyaltyConfig {
  id                      Int      @id @default(1)
  pointsPerJod            Float    @default(10)
  tierGoldMinOrders       Int      @default(10)
  tierPlatinumMinOrders   Int      @default(25)
  pointsMultiplierGold    Float    @default(1.5)
  pointsMultiplierPlatinum Float    @default(2.0)
  reviewPoints            Int      @default(50)
  referralPoints          Int      @default(100)
  socialSharePoints       Int      @default(20)
  happyHourMultiplier     Float    @default(2.0)
  happyHourStart          String   @default("16:00")
  happyHourEnd            String   @default("18:00")
  isHappyHourEnabled      Boolean  @default(false)
  cancellationCompensationRate Float @default(0.05)
  pointsToJodRate         Float    @default(100)
  minPointsToRedeem       Int      @default(500)
  minCompensationPoints   Int      @default(50)
  rewardExpiryDays        Int      @default(30)
  updatedAt               DateTime @updatedAt
}

model FinancialLedger {
  id              Int      @id @default(autoincrement())
  customerId      Int?
  orderId         Int?
  branchId        String
  type            String   // DEBIT (Money Out), CREDIT (Money In)
  category        String   // ORDER_PAYMENT, REFUND, WALLET_CREDIT, ADJUSTMENT
  amount          Decimal  @db.Decimal(10, 2)
  balanceBefore   Decimal  @db.Decimal(10, 2)
  balanceAfter    Decimal  @db.Decimal(10, 2)
  method          String   @default("CASH") // CASH, WALLET, CARD
  idempotencyKey  String?  @unique
  referenceId     String?  // Order Number or Transaction ID
  description     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  deletedBy       String?

  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  approvals       FinancialApproval[]
  @@index([customerId])
  @@index([orderId])
  @@index([branchId])
  @@index([createdAt])
  @@index([branchId, type, createdAt])
  @@index([isDeleted, branchId])
}

model FinancialApproval {
  id              String   @id @default(uuid())
  operationType   String   // REFUND, PRICE_OVERRIDE, CANCELLATION
  entityId        String   // Order ID or Ledger ID
  requestedBy     Int
  requestedByRole String
  payload         Json     // Stores the intended change
  status          FinancialApprovalStatus @default(PENDING)
  approvedBy      Int?
  rejectionReason String?
  amount          Decimal? @db.Decimal(10, 2)
  riskLevel       String   @default("LOW") // HIGH, MEDIUM, LOW
  
  // Traceability Link
  ledgerEntryId   Int?
  ledgerEntry     FinancialLedger? @relation(fields: [ledgerEntryId], references: [id])
  
  branchId        String?
  branch          Branch?  @relation(fields: [branchId], references: [id])

  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)
  eventSequence   Int      @default(0)

  @@index([status])
  @@index([operationType])
  @@index([riskLevel])
}

enum FinancialApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model OrderModificationEvent {
  id              String   @id @default(uuid())
  orderId         Int
  type            String   // REPLACEMENT_REQUESTED, REPLACEMENT_CONFIRMED, REPLACEMENT_REJECTED, PARTIAL_CANCEL
  status          String   @default("PENDING") // PENDING, COMPLETED, EXPIRED
  payload         Json     // Stores delta: { removedItems: [], addedItems: [], priceDiff: 0 }
  adminId         Int?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model OutboxEvent {
  id             String    @id @default(uuid())
  type           String
  aggregateId    String?
  aggregateType  String?
  version        Int       @default(1)
  eventSequence  Int       @default(1)
  payload        Json
  metadata       Json?
  status         String    @default("PENDING") // PENDING, DISPATCHED, FAILED
  error          String?
  retries        Int       @default(0)
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

model RestaurantSubscription {
  id         Int      @id @default(autoincrement())
  userId     String?
  fcmToken   String
  targetTime DateTime
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([notified, targetTime])
}

model RewardItem {
  id              Int      @id @default(autoincrement())
  title           String
  titleEn         String?
  description     String?
  descriptionEn   String?
  image           String?
  pointsCost      Int
  isActive        Boolean  @default(true)
  minTier         String   @default("SILVER") // SILVER, GOLD, PLATINUM
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  customerRewards CustomerReward[]
}

model CustomerReward {
  id              Int      @id @default(autoincrement())
  customerId      Int
  rewardItemId    Int
  code            String   @unique @default(uuid())
  status          String   @default("ACTIVE") // ACTIVE, USED, EXPIRED
  purchasedAt     DateTime @default(now())
  usedAt          DateTime?
  expiresAt       DateTime?
  
  customer        Customer   @relation(fields: [customerId], references: [id])
  rewardItem      RewardItem @relation(fields: [rewardItemId], references: [id])

  @@index([customerId, status])
  @@index([code])
}

model BranchMetric {
  id            String   @id @default(uuid())
  branchId      String   @unique
  totalOrders     Int
  activeOrders    Int
  cancellations   Int
  revenue         Decimal  @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
  version         Int      @default(1)
  eventSequence   Int      @default(1) // ðŸ›¡ï¸ Aggregate-scoped sequence
  previousVersion Int      @default(0) // ðŸ”— Causal link
  causedByEventId String?  // ðŸ•µï¸ Traceability
  snapshotEpoch   Int      @default(1) // ðŸ›ï¸ Resync boundary
  branch          Branch   @relation(fields: [branchId], references: [id])
}

model AwardedLoyaltyPoints {
  id          String   @id @default(uuid())
  orderId     Int      @unique
  customerId  Int
  points      Int
  multiplier  Float
  awardedAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
  @@index([orderId])
  @@index([customerId])
}

model LoyaltyLedger {
  id              Int      @id @default(autoincrement())
  customerId      Int
  type            String   // CREDIT (Points In), DEBIT (Points Out)
  category        String   // ORDER_AWARD, REVIEW_AWARD, SOCIAL_AWARD, REDEMPTION, ADJUSTMENT
  points          Int      // Amount of points (Saturating Integer)
  balanceBefore   Int      // Snapshot for verification
  balanceAfter    Int      // Snapshot for verification
  
  // ðŸ›¡ï¸ [INTEGRITY] Unique Idempotency Key
  // Format: source_type:aggregate_id:action_hash
  idempotencyKey  String   @unique 
  
  // ðŸ”— [TRACEABILITY] Causal Links
  referenceId     String?  // OrderNumber, ReviewId, or ActionUUID
  description     String?
  metadata        Json?    // { ip: "...", device: "...", version: 1 }
  
  createdAt       DateTime @default(now())
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt(sort: Desc)])
  @@index([category])
  @@index([idempotencyKey])
  @@index([isDeleted])
}

model DailyFinancialSnapshot {
  id              String   @id @default(uuid())
  date            DateTime // The day this snapshot represents
  branchId        String
  totalRevenue    Decimal  @db.Decimal(10, 2)
  netRevenue      Decimal  @db.Decimal(10, 2)
  taxTotal        Decimal  @db.Decimal(10, 2)
  discountTotal   Decimal  @db.Decimal(10, 2)
  orderCount      Int
  cancelledCount  Int
  lossTotal       Decimal  @db.Decimal(10, 2)
  isFrozen        Boolean  @default(true) // Snapshots are immutable by default
  createdAt       DateTime @default(now())

  branch          Branch   @relation("BranchSnapshots", fields: [branchId], references: [id], onDelete: Restrict)
  
  @@unique([date, branchId])
  @@index([date])
  @@index([branchId])
}

model HappyHour {
  id                    String         @id @default(uuid())
  branchId              String
  branch                Branch         @relation(fields: [branchId], references: [id])
  dayOfWeek             Int            // 0-6
  startTime             String         // HH:MM
  endTime               String         // HH:MM
  discount              Int            // percentage
  description           String?
  status                String         @default("active") // active/inactive
  timezone              String?        @default("Africa/Cairo")
  eligibilityCriteria   String?        @default("ALL") // ALL, LOYALTY_TIER, TARGETED
  loyaltyTierRequired   String?        // SILVER, GOLD, PLATINUM
  targetCustomerIds     String[]       @default([])
  discountType          String?        @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue         Decimal?       @default(0) @db.Decimal(5, 2)
  rewardMultiplier      Decimal?       @default(1.0) @db.Decimal(3, 2)
  daysOfWeek            Int[]          @default([])
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  logs                  HappyHourLog[]

  @@index([branchId, isActive])
  @@index([timezone])
  @@index([status])
}

model HappyHourLog {
  id               String   @id @default(uuid())
  happyHourId      String
  happyHour        HappyHour @relation(fields: [happyHourId], references: [id])
  branchId         String
  startTime        DateTime
  endTime          DateTime
  discount         Int
  createdAt        DateTime @default(now())

  @@index([happyHourId])
  @@index([branchId])
  @@index([createdAt])
}

model UserBranchPreference {
  id               String   @id @default(uuid())
  userId           String   // UUID of User or Customer
  branchId         String
  notifications    Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([userId, branchId])
}

model BusinessPolicy {
  id          String   @id @default(uuid())
  branchId    String?  // NULL means Global Policy
  key         String   // e.g., 'SLA_PREP_TIME', 'DELIVERY_BASE_FEE'
  value       Json     // { val: 20, unit: 'minutes' }
  category    String   // SLA, PRICING, CANCELLATION, SYSTEM, SECURITY, LOYALTY
  description String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  branch      Branch?  @relation(fields: [branchId], references: [id])

  @@unique([key, branchId])
  @@index([category])
  @@index([branchId])
}

model IdempotencyKey {
  id              String   @id @default(uuid())
  key             String   @unique
  operation       String
  responsePayload Json?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  userId          String?  // Changed to String to match UUID
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  
  @@index([key])
}

model BiometricDevice {
  id        String   @id @default(uuid())
  userId    String   // Supports User or Customer string UUID mapping
  deviceId  String   @unique // Physical hardware device identifier
  token     String   @unique // Long-lived symmetric encrypted biometric refresh credential
  isActive  Boolean  @default(true)
  metadata  Json?    // Client telemetry context
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deviceId])
}

model SystemSettings {
  id                      Int      @id @default(autoincrement())
  key                     String   @default("GLOBAL")
  value                   Json?    // Legacy support
  businessConfig          Json?    // { slaPrepTime: 20, ... }
  securityConfig          Json?    // { maxLoginAttempts: 5, ... }
  freeCancelWindowMinutes Int      @default(5)
  spamCancelLimit         Int      @default(3)
  spamTimeWindowMinutes   Int      @default(60)
  defaultDeliveryFee      Decimal  @default(1.0) @db.Decimal(10, 2)
  updatedAt               DateTime @updatedAt

  @@unique([key])
}

model CouponRequest {
  id          String   @id @default(uuid())
  orderId     Int
  customerId  Int
  itemId      Int
  itemPrice   Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING, RESOLVED, REJECTED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order    @relation(fields: [orderId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([status])
}

model DailyReport {
  id              String   @id @default(uuid())
  date            DateTime // Date of the report
  branchId        String
  totalSales      Decimal  @default(0) @db.Decimal(10, 2)
  orderCount      Int      @default(0)
  cancelledCount  Int      @default(0)
  avgPrepTime     Int      @default(0) // in minutes
  taxTotal        Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  branch          Branch   @relation(fields: [branchId], references: [id])
  
  @@unique([date, branchId])
  @@index([date])
  @@index([branchId])
}
